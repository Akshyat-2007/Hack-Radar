# HackRadar configuration
# Set to false to use live TinyFish Search/Fetch and Gemini LLM APIs, or true for local mock demo
USE_MOCKS=false

# TinyFish unified API key (Search, Fetch, and Agent)
TINYFISH_API_KEY=your_tinyfish_api_key_here
SEARCH_API_KEY=your_tinyfish_api_key_here
FETCH_API_KEY=your_tinyfish_api_key_here
AGENT_API_KEY=your_tinyfish_api_key_here

# Google Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-flash-lite-latest

# Service endpoints
SEARCH_ENDPOINT=https://api.search.tinyfish.ai
FETCH_ENDPOINT=https://api.fetch.tinyfish.ai
AGENT_ENDPOINT=https://agent.tinyfish.ai/v1/automation/run
LLM_ENDPOINT=https://generativelanguage.googleapis.com/v1beta
