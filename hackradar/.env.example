# HackRadar configuration
# Copy to .env and fill in real values to switch from mocks to live APIs.

# Set to "true" to use mock providers (deterministic sample data). Default: true
USE_MOCKS=true

# Search provider (e.g. Serper, Brave, Bing API)
SEARCH_API_KEY=

# Fetch provider (e.g. Jina Reader, r.jina.ai)
FETCH_API_KEY=

# Agent provider (optional deep-scan agent)
AGENT_API_KEY=

# LLM provider (e.g. OpenAI, Anthropic, Gemini)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Optional overrides
SEARCH_ENDPOINT=
FETCH_ENDPOINT=
LLM_ENDPOINT=